# Copy to .env in this folder before `supabase start`. These are local placeholders, not real keys.
# The service role key is created by the CLI and must only be set as a function secret. Never put it here for a hosted project.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=local-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=local-google-secret
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=local-github-client-id
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=local-github-secret
